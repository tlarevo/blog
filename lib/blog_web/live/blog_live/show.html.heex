<Layouts.app flash={@flash}>
  <%= if @post do %>
    <div id="reading-progress" aria-hidden="true"></div>
    <article>
      <div class="title">
        <h1 class="title">{@post["title"]}</h1>
        <div class="meta">
          Posted on {BlogWeb.BlogLive.Helpers.format_date(@post["createdAt"])}
          <%= if @reading_time do %>
            <span class="meta">· {@reading_time} min read</span>
          <% end %>
        </div>
      </div>
      <script type="application/ld+json">
        {Jason.encode!(%{
          "@context" => "https://schema.org",
          "@type" => "BlogPosting",
          "headline" => @post["title"],
          "datePublished" => @post["createdAt"],
          "author" => %{
            "@type" => "Person",
            "name" => "Tharindu Abeydeera",
            "url" => "https://github.com/tlarevo"
          },
          "publisher" => %{
            "@type" => "Person",
            "name" => "Tharindu Abeydeera"
          },
          "url" => "https://tlarevo.me/posts/#{@post["number"]}"
        })}
      </script>


      <section class="body">
        {BlogWeb.Markdown.to_html(@post["body"])}
      </section>

      <p>
        <.link navigate={~p"/posts"}>Back to posts</.link>
      </p>
    </article>
  <% else %>
    <section class="notice">
      <h1>Post unavailable</h1>
      <p>The post could not be loaded.</p>
      <p>
        <.link navigate={~p"/posts"}>Back to posts</.link>
      </p>
    </section>
  <% end %>
</Layouts.app>
