<Layouts.app flash={@flash}>
  <h1 class="page-title">All articles</h1>

  <%= if @load_error do %>
    <section class="notice">
      <strong>Posts unavailable</strong>
      <p>The post list could not be loaded.</p>
    </section>
  <% else %>
    <input
      type="search"
      id="post-search"
      placeholder="Search posts…"
      aria-label="Search posts"
      autocomplete="off"
    />
    <%= if Enum.empty?(@posts) do %>
      <p class="meta">No posts have been published yet.</p>
    <% else %>
      <ul class="posts">
        <%= for post <- @posts do %>
          <li class="post">
            <.link navigate={~p"/posts/#{post["number"]}"}>{post["title"]}</.link>
            <span class="meta">{BlogWeb.BlogLive.Helpers.format_date(post["createdAt"])}</span>
          </li>
        <% end %>
      </ul>
      <%= if @has_next_page do %>
        <button
          class="load-more"
          phx-click="load-more"
          phx-disable-with="Loading…"
        >
          Load more
        </button>
      <% end %>
    <% end %>
  <% end %>

  <script id="posts-data" type="application/json">{@posts_json}</script>
</Layouts.app>
