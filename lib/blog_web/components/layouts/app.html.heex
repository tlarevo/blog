<div class="content">
  <header>
    <.link navigate={~p"/"} class="main">Blog</.link>
    <nav aria-label="Main navigation">
      <.link navigate={~p"/"}>Home</.link>
      <.link navigate={~p"/posts"}>All posts</.link>
      <a href="https://github.com/tlarevo/blog">Source</a>
      <button id="theme-toggle" type="button" phx-update="ignore" aria-label="Toggle theme">
      </button>
    </nav>
  </header>

  <.flash_group flash={@flash} />

  <main>
    <%= if assigns[:inner_block] do %>
      {render_slot(@inner_block)}
    <% else %>
      {assigns[:inner_content]}
    <% end %>
  </main>

  <footer>
    <div class="footer-info">
      2026 <a href="https://github.com/athul/archie">Archie Theme</a> adapted for Phoenix.
    </div>
  </footer>
</div>
